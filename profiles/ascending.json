{
  "model": "AoPC-Seg v1.1 ascending aorta",
  "weights": "weights/ascending.onnx",
  "input": {
    "name": "image",
    "layout": "NCHW",
    "shape": [
      1,
      1,
      224,
      256
    ]
  },
  "output": {
    "name": "logits",
    "layout": "NCHW",
    "classes": {
      "0": "background",
      "1": "ascending aorta"
    },
    "argmax_axis": 1
  },
  "target_spacing_yx_mm": [
    1.25,
    1.25
  ],
  "normalization": "zscore_image",
  "patch_size_yx": [
    224,
    256
  ],
  "tiling": {
    "step_fraction": 0.5,
    "gaussian_sigma_fraction": 0.125
  }
}